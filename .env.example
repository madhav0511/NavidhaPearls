# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Sheets Webhook URL for capturing customer newsletter signups
VITE_GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbygiRhRbbQOBlWvWt1Ud4CCCtw-EnBhOIxSMyZfr65OALKFtKjSB83HvJONGZMgMiMHvQ/exec"

# Google Sheets Webhook URL for capturing Consultation Bookings (can be same or distinct Apps Script URL)
VITE_CONSULTATION_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbygiRhRbbQOBlWvWt1Ud4CCCtw-EnBhOIxSMyZfr65OALKFtKjSB83HvJONGZMgMiMHvQ/exec"

# Optional: Razorpay Key ID for live payment gateway checkout (e.g. rzp_test_... or rzp_live_...)
VITE_RAZORPAY_KEY_ID=""

# AiSensy WhatsApp Business API Integration
# 1. AISENSY_API_KEY: Generated from AiSensy Dashboard -> Manage -> API Keys
AISENSY_API_KEY=""
# 2. AISENSY_CAMPAIGN_NAME: Live API Campaign Name in AiSensy (e.g., navidha_website_lead)
AISENSY_CAMPAIGN_NAME="navidha_website_lead"
# 3. AISENSY_BUSINESS_NUMBER: Official Navidha WhatsApp Business registered number
AISENSY_BUSINESS_NUMBER="918985133732"
VITE_WHATSAPP_PHONE_NUMBER="918985133732"

